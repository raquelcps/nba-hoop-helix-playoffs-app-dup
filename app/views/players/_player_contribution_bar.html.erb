<div class="contribution-bar">

    <p class="contribution-label">
      Contribution to Team
    </p>

  <div class="d-flex align-items-center gap-2">

    <div class="progress flex-grow-1"
        style="height: 20px;">

      <div class="progress-bar contribution-fill"
          role="progressbar"
          style="width: <%= format_stat_value(contribution) %>%;">
      </div>

    </div>

    <span class="contribution-percent mb-3">
      <%= format_stat_value(contribution) %>%
    </span>
  </div>

  <div class="d-flex small justify-content-between">

    <span class="player-value">
      <%= format_stat_value(player_value, precision: 0) %>
    </span>

    <%# TODO: Move Minutes-specific team-total calculations into shared stat metadata. %>
    <%
      displayed_team_value =
        stat == :min ? team_value * 5 : team_value
    %>

    <span class="team-value text-muted">
      <%= format_stat_value(displayed_team_value, precision: 0) %>
    </span>    

  </div>

</div>