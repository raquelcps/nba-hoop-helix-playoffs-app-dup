<div class="team-roster">

  <h3 class="team-roster-title text-uppercase text-muted">
    Roster
  </h3>

  <!-- Mobile roster is collapsed by default -->
  <!-- This buttons toggles the collapse state of the roster on mobile -->
  <button
    class="mobile-player-selector btn btn-link d-lg-none"
    type="button"
    data-bs-toggle="collapse"
    data-bs-target="#teamRosterCollapse"
    aria-expanded="false"
    aria-controls="teamRosterCollapse">

    <span class="selected-player-name">
      Select Player
    </span>

    <span class="selected-player-pin d-none">
      <i class="fa fa-thumb-tack"></i>
    </span>

    <span class="expand-icon">
      <i class="fa fa-angle-down"></i>
    </span>

  </button>


  <!-- Desktop roster is always expanded and not collapsible -->
  <div
    class="collapse d-lg-block"
    id="teamRosterCollapse">

    <div class="mobile-roster-actions d-lg-none">

      <button
        type="button"
        class="clear-player-selection d-none"
        data-clear-player-selection>

        <i class="fa fa-times"></i>
        Clear selected player

      </button>

    </div>

    <input
      type="search"
      id="roster-search"
      class="team-roster-search"
      placeholder="Find a player...">

    <% @roster.sort_by { |player| player_last_name(player) }.each do |player| %>

      <% if @playoff_players.include?(player[:player_id].to_s) %>

        <div
          class="roster-player font-roboto"
          data-player-id="<%= player[:player_id] %>"
          data-player-name="<%= player[:player_name].downcase %>">

          <div class="roster-player-info">

            <%= image_tag player[:photo_url],
              class: "roster-player-photo",
              alt: player[:player_name] %>

            <div class="roster-player-details">
              <div class="roster-player-name">
                <p><%= player[:player_name] %></p>
              </div>

              <div class="roster-player-meta">
                #<%= player[:jersey] %>
                &bull;
                <%= player[:position] %>
                &bull;
                <%= player[:exp] %> yrs
              </div>
            </div>

          </div>

          <div class="roster-player-actions">
            <button
              type="button"
              class="roster-player-pin"
              aria-label="Pin player highlights"
              data-tooltip="Pin highlights">

              <i class="fa fa-thumb-tack"></i>

            </button>

            <%= link_to player_path(player[:player_id],
              team_id: params[:id]),
              class: "roster-player-profile",
              aria: {label: "View player profile"},
              data: {tooltip: "Player profile"} do %>

              <i class="fa fa-external-link"></i>

            <% end %>

          </div>

        </div>

      <% else %>

        <div
          class="roster-player roster-player-inactive font-roboto"
          data-player-name="<%= player[:player_name].downcase %>">

          <%= image_tag player[:photo_url],
            class: "roster-player-photo roster-player-inactive",
            alt: player[:player_name] %>

          <div class="roster-player-details roster-player-inactive">
            <div class="roster-player-name roster-player-inactive">
              <p>
              <%= player[:player_name] %>
              </p>
            </div>

            <div class="roster-player-meta roster-player-inactive">
              No playoff stats
            </div>
          </div>
        </div>

      <% end %>

    <% end %>
  </div>
</div>
