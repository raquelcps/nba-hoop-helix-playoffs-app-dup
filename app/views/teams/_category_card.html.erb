<div class="category-card">
  <div class="category-card-header">
    <h5><%= title %></h5>
    <span class="team-total">Team: <%= team_total %></span>
  </div>

  <table class="category-card-table">
    <tbody>
      <% players
          .sort_by { |player| -(player[stat] || 0) }
          .each_with_index do |player, index| %>

        <% value = player[stat] || 0 %>
        <% contribution =
            player_contribution(
              value,
              team_total,
              multiplier: (stat == :min ? 5 : 1)
            )
        %>

        <tr data-player-id="<%= player[:player_id] %>"
            data-rank="<%= index + 1 %>"
            class="category-card-row">
          <td class="player-rank">
            <%= index + 1 %>
          </td>

          <td class="player-name">
            <%= player[:player_name] %>
          </td>

          <td class="player-value">
            <%= format_contribution_percentage(value, precision: 0) %>
          </td>

          <td class="player-percent">
            <%= format_contribution_percentage(contribution) %>%
          </td>
        </tr>

      <% end %>
    </tbody>
  </table>

  <button
    type="button"
    class="category-card-expand btn btn-link"
    aria-expanded="false">
    <span class="expand-text">
      Full Roster Contributions
    </span>
    <span class="expand-icon">
      ▼
    </span>
  </button>

</div>
