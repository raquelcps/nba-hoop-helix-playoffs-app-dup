<div class="category-card">
  <div class="category-card-header">
    <h5 class="category-card-title">
      <%= title %>

      <%= render "shared/stat_info", label: title, info: info %>

    </h5>

    <%# TODO: Move Minutes-specific team-total calculations into shared stat metadata. %>
    <%
      displayed_team_value =
        stat == :min ? team_total * 5 : team_total
    %>

    <span class="team-total">
      Team:<%= format_stat_value(displayed_team_value, precision: 0) %>
    </span>
  </div>

  <table class="category-card-table">
    <tbody>
      <% players
          .sort_by { |player| -(player[stat] || 0) }
          .each_with_index do |player, index| %>

        <% value = player[stat] || 0 %>
        <% contribution =
            player_contribution(
              value,
              team_total,
              multiplier: (stat == :min ? 5 : 1)
            )
        %>

        <tr data-player-id="<%= player[:player_id] %>"
            data-rank="<%= index + 1 %>"
            class="category-card-row">
          <td class="player-rank">
            <%= index + 1 %>
          </td>

          <td class="player-name">
            <%= player[:player_name] %>
          </td>

          <td class="player-value">
            <%= format_stat_value(value, precision: 0) %>
          </td>

          <td class="player-percent">
            <%= format_stat_value(contribution) %>%
          </td>
        </tr>

      <% end %>
    </tbody>
  </table>

  <button
    type="button"
    class="category-card-expand btn btn-link"
    aria-expanded="false">
    <span class="expand-text">
      Full Roster Contributions
    </span>
    <span class="expand-icon">
      ▼
    </span>
  </button>

</div>
